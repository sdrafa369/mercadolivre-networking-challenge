###### FORTIGATE ######

config vpn ipsec phase1-interface
    edit "VPN-PALOALTO"
        set interface "port1"
        set ike-version 2
        set peertype any
        set net-device enable
        set proposal des-sha256
        set dhgrp 14
        set remote-gw 192.168.1.200
        set psksecret SenhaVPN@2026
    next
end

config vpn ipsec phase2-interface
    edit "VPN-PALOALTO-P2"
        set phase1name "VPN-PALOALTO"
        set proposal des-sha256
        set dhgrp 14
        set src-subnet 192.168.10.0 255.255.255.0
        set dst-subnet 192.168.20.0 255.255.255.0
    next
end

###### PALOALTO ######

Configuração do Palo Alto

1. Interfaces

WAN
set network interface ethernet ethernet1/1 layer3 ip 192.168.1.200/24
set network interface ethernet ethernet1/1 layer3 interface-management-profile Acesso

LAN
set network interface ethernet ethernet1/2 layer3 ip 192.168.80.1/24
set network interface ethernet ethernet1/2 layer3 interface-management-profile Acesso
Tunnel Interface
set network interface tunnel units tunnel.1 ip 169.255.1.2/30
set network interface tunnel units tunnel.1 mtu 1427
set network interface tunnel units tunnel.1 comment VPN-FORTIGATE

2. Zones

WAN
set zone WAN network layer3 ethernet1/1

LAN
set zone LAN network layer3 ethernet1/2

VPN
set zone VPN network layer3 tunnel.1

3. Perfil Criptográfico IKE

IKE Phase1
Parâmetros
Item	Valor
Encryption	DES
Authentication	SHA256
DH Group	14
Lifetime	28800

Configuração

set network ike crypto-profiles ike-crypto-profiles IKE-PROFILE encryption des
set network ike crypto-profiles ike-crypto-profiles IKE-PROFILE hash sha256
set network ike crypto-profiles ike-crypto-profiles IKE-PROFILE dh-group group14
set network ike crypto-profiles ike-crypto-profiles IKE-PROFILE lifetime seconds 28800

4. Perfil Criptográfico IPsec
Phase2
Parâmetros
Item	Valor
Encryption	DES
Authentication	SHA256
DH Group	14
Lifetime	3600

Configuração

set network ike crypto-profiles ipsec-crypto-profiles IPSEC-PROFILE esp encryption des
set network ike crypto-profiles ipsec-crypto-profiles IPSEC-PROFILE esp authentication sha256
set network ike crypto-profiles ipsec-crypto-profiles IPSEC-PROFILE dh-group group14
set network ike crypto-profiles ipsec-crypto-profiles IPSEC-PROFILE lifetime seconds 3600

5. IKE Gateway
Parâmetros
Item	Valor
Peer IP	192.168.1.100
Interface Local	ethernet1/1
Exchange Mode	Main
NAT Traversal	Enabled
IKE Version	IKEv1
Authentication	Pre-Shared Key

Configuração
set network ike gateway VPN-FORTIGATE authentication pre-shared-key key <PSK>
set network ike gateway VPN-FORTIGATE peer-address ip 192.168.1.100
set network ike gateway VPN-FORTIGATE local-address interface ethernet1/1
set network ike gateway VPN-FORTIGATE protocol ikev1 ike-crypto-profile IKE-PROFILE
set network ike gateway VPN-FORTIGATE protocol ikev1 exchange-mode main
set network ike gateway VPN-FORTIGATE protocol-common nat-traversal enable yes
set network ike gateway VPN-FORTIGATE protocol-common fragmentation enable no
set network ike gateway VPN-FORTIGATE protocol ikev1 dpd enable no

6. Tunnel IPsec
Proxy-ID
Local	Remote
192.168.80.0/24	192.168.70.0/24
Configuração

set network tunnel ipsec VPN-FORTIGATE auto-key ike-gateway VPN-FORTIGATE
set network tunnel ipsec VPN-FORTIGATE auto-key ipsec-crypto-profile IPSEC-PROFILE
set network tunnel ipsec VPN-FORTIGATE auto-key proxy-id FGT-PROXY protocol any
set network tunnel ipsec VPN-FORTIGATE auto-key proxy-id FGT-PROXY local 192.168.80.0/24
set network tunnel ipsec VPN-FORTIGATE auto-key proxy-id FGT-PROXY remote 192.168.70.0/24
set network tunnel ipsec VPN-FORTIGATE tunnel-interface tunnel.1
set network tunnel ipsec VPN-FORTIGATE tunnel-monitor enable no

7. Roteamento
Rota Estática
Destino	Next-Hop	Interface
192.168.70.0/24	169.255.1.1	tunnel.1

Configuração

set network virtual-router default routing-table ip static-route TO-FORTIGATE destination 192.168.70.0/24
set network virtual-router default routing-table ip static-route TO-FORTIGATE interface tunnel.1
set network virtual-router default routing-table ip static-route TO-FORTIGATE nexthop ip-address 169.255.1.1
set network virtual-router default routing-table ip static-route TO-FORTIGATE metric 10

8. Policies de Segurança

LAN → VPN
set rulebase security rules VPN-OUT from LAN
set rulebase security rules VPN-OUT to VPN
set rulebase security rules VPN-OUT source any
set rulebase security rules VPN-OUT destination any
set rulebase security rules VPN-OUT application any
set rulebase security rules VPN-OUT service any
set rulebase security rules VPN-OUT action allow

VPN → LAN
set rulebase security rules VPN-IN from VPN
set rulebase security rules VPN-IN to LAN
set rulebase security rules VPN-IN source any
set rulebase security rules VPN-IN destination any
set rulebase security rules VPN-IN application any
set rulebase security rules VPN-IN service any
set rulebase security rules VPN-IN action allow

9. Validação
Verificar IKE SA
show vpn ike-sa
Verificar IPsec SA
show vpn ipsec-sa
Testar Tunnel
test vpn ipsec-sa tunnel VPN-FORTIGATE
Verificar Rotas
show routing route
Status Final
Item	Status
IKE Phase1	UP
IPsec Phase2	UP
Proxy-ID	OK
Roteamento	OK
Policies	OK
Comunicação entre redes	FUNCIONANDO